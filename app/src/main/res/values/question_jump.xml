<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="question_jump_title">选择题目</string>
    <string name="question_jump_subtitle">当前第 %1$d 题，共 %2$d 题</string>
    <string name="question_jump_open">第 %1$d / %2$d 题，点击选择题目</string>
    <string name="question_jump_close">关闭题目选择</string>
    <string name="question_jump_previous">上一组</string>
    <string name="question_jump_next">下一组</string>
    <string name="question_jump_range">%1$d–%2$d / %3$d</string>
    <string name="question_jump_target">跳转到第 %1$s 题</string>
    <string name="question_jump_current">第 %1$s 题，当前题</string>
    <string name="question_jump_hint">点击题号跳转，蓝色为当前题</string>
    <string name="question_jump_continue_unanswered">还有未答题，已返回继续作答</string>

    <style name="ThemeOverlay.QuestionJumpSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.QuestionJumpSheet</item>
        <item name="android:navigationBarColor">@color/brand_card</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
    <style name="Widget.QuestionJumpSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/brand_card</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.QuestionJumpSheet</item>
    </style>
    <style name="ShapeAppearance.QuestionJumpSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="Widget.QuestionJumpPage" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/question_jump_page_text</item>
        <item name="backgroundTint">@color/question_jump_page_background</item>
        <item name="strokeColor">@color/question_jump_page_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
</resources>
